#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/setup'
require 'optparse'
require_relative '../lib/blade_mcp'
require_relative '../lib/blade_mcp/embedder'
require_relative '../lib/blade_mcp/extractor'
require_relative '../lib/blade_mcp/importer'
require_relative '../lib/blade_mcp/redmine'
require_relative '../lib/blade_mcp/vault'

usage = <<~TEXT
  Usage: blade-mcp COMMAND [options]

  Commands:
    migrate          Apply the migrations in db/migrate that DATABASE_URL has not had yet
    import           Import every message of the given lists from the vault
    import-redmine   Import comments by or about matz from the Redmine database in BUGS_DATABASE_URL
    update           Import new messages, sync bugs.ruby-lang.org comments, extract statements and embed what is new
    embed            Compute embeddings for messages and statements that have none
    extract          Have the chat model record what matz said in his mails and in bugs.ruby-lang.org comments

  Options:
TEXT

options = {}
parser = OptionParser.new do |opts|
  opts.banner = usage
  opts.on('--lists LIST,...', Array,
          "Lists to process (default: all for import and update, #{BladeMcp::Embedder::LISTS.join(',')} for embed)") do |lists|
    unknown = lists - BladeMcp::LISTS
    raise OptionParser::InvalidArgument, "#{unknown.join(',')} (known: #{BladeMcp::LISTS.join(',')})" if unknown.any?
    options[:lists] = lists
  end
  opts.on('--sources SOURCE,...', Array, "Sources to extract from (default: #{BladeMcp::Extractor::SOURCES.join(',')})") do |sources|
    unknown = sources - BladeMcp::Extractor::SOURCES
    raise OptionParser::InvalidArgument, "#{unknown.join(',')} (known: #{BladeMcp::Extractor::SOURCES.join(',')})" if unknown.any?
    options[:sources] = sources
  end
  opts.on('--limit N', Integer, 'Stop after N messages per list (import), in total (embed) or per source (extract)') { |n| options[:limit] = n }
  opts.on('--concurrency N', Integer, 'Parallel vault downloads (default 8) or model calls (default 4)') { |n| options[:concurrency] = n }
end

begin
  parser.parse!
rescue OptionParser::ParseError => e
  abort "blade-mcp: #{e.message}\n\n#{parser.help}"
end

command = ARGV.shift
abort parser.help unless %w[migrate import import-redmine update embed extract].include?(command)
abort 'blade-mcp: BUGS_DATABASE_URL is not set' if command == 'import-redmine' && !ENV['BUGS_DATABASE_URL']

conn = BladeMcp::DB.connect
$stdout.sync = true

def embed(conn, lists, limit)
  client = BladeMcp::Inference::Embedding.from_env
  return puts 'EMBEDDING_URL and EMBEDDING_KEY are not set, skipping embeddings' unless client
  embedder = BladeMcp::Embedder.new(conn, client)
  embedder.run(lists: lists || BladeMcp::Embedder::LISTS, limit:)
  embedder.run_statements(limit:)
end

def extract(conn, sources, limit, concurrency)
  client = BladeMcp::Inference::Chat.from_env or return
  BladeMcp::Extractor.new(conn, client, concurrency:).run(sources: sources || BladeMcp::Extractor::SOURCES, limit:)
end

case command
when 'migrate'
  BladeMcp::DB.migrate
when 'import', 'update'
  importer = BladeMcp::Importer.new(BladeMcp::Store.new(conn), BladeMcp::Vault.new,
                                    concurrency: options.fetch(:concurrency, 8))
  importer.run(options[:lists] || BladeMcp::LISTS, limit: options[:limit], only_new: command == 'update')
  if command == 'update'
    embed(conn, nil, nil)
    BladeMcp::Redmine.new(conn).sync
    extract(conn, nil, nil, 4) or puts 'INFERENCE_URL and INFERENCE_KEY are not set, skipping extraction'
    embed(conn, nil, nil)
  end
when 'import-redmine'
  BladeMcp::Redmine.new(conn).import(BladeMcp::DB.connect(ENV.fetch('BUGS_DATABASE_URL')))
when 'embed'
  embed(conn, options[:lists], options[:limit])
when 'extract'
  extract(conn, options[:sources], options[:limit], options.fetch(:concurrency, 4)) or
    abort 'blade-mcp: INFERENCE_URL and INFERENCE_KEY are not set'
end
